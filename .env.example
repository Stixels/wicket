# --- Product ---
PRODUCT_NAME=Escape Director
PRODUCT_DESCRIPTION=A browser-based platform for designing escape rooms, running live games, presenting the Live View and reviewing sessions.
# Origins allowed to embed the widget (comma separated). Leave empty to allow any.
ALLOWED_ORIGINS=https://app.escapedirector.com

# --- Assistant --- (leave ANTHROPIC_API_KEY empty to send every chat straight to the team)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# --- Docs --- any GitHub repo of markdown (GitBook Git Sync works as-is)
DOCS_GITHUB_REPO=directorhq/escape-director-documentation
DOCS_BASE_URL=https://docs.escapedirector.com
# DOCS_GITHUB_TOKEN=   # only needed for a private docs repo

# --- Discord ---
RELAY=discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Who gets pinged when the assistant asks for a person: a role (<@&ROLE_ID>), @here, or empty
DISCORD_HANDOFF_MENTION=

# --- Storage --- (Railway: mount a volume at /data)
DATABASE_PATH=/data/feedback-loop.db
