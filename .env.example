# Local port (Railway sets its own)
PORT=4318

# Test page with the widget at /. On by default except in production (the Docker image).
# PLAYGROUND=true

# --- Product ---
PRODUCT_NAME=Escape Director
PRODUCT_DESCRIPTION=A browser-based platform for designing escape rooms, running live games, presenting the Live View and reviewing sessions.
# Origins allowed to embed the widget (comma separated). Leave empty to allow any.
ALLOWED_ORIGINS=https://app.escapedirector.com

# --- Assistant --- (set one key; leave both empty to send every chat straight to the team)
# Vercel AI Gateway key (Vercel dashboard > AI Gateway > API keys)
AI_GATEWAY_API_KEY=
# Or call Anthropic directly
# ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5
AGENT_EFFORT=low

# --- Signed-in users --- your backend signs a 5-minute HS256 JWT (sub, name, email, plan) with this.
# Generate one with: openssl rand -base64 48
# IDENTITY_SECRET=

# --- Profiles, rules and budgets --- defaults to config/wicket.yaml; or a path, or the YAML itself
# WICKET_CONFIG=

# --- Docs --- any GitHub repo of markdown (GitBook Git Sync works as-is)
DOCS_GITHUB_REPO=directorhq/escape-director-documentation
DOCS_BASE_URL=https://docs.escapedirector.com
# DOCS_GITHUB_TOKEN=   # only needed for a private docs repo

# --- Discord ---
RELAY=discord
DISCORD_BOT_TOKEN=
# Your server id. On boot the service creates any missing channels and the Team role
# (it never changes or deletes existing ones) and finds the ids below by itself.
DISCORD_GUILD_ID=
# Use an existing staff role instead of creating "Team"
# DISCORD_TEAM_ROLE=Team
# Optional overrides if you'd rather point at channels by id:
# DISCORD_CHANNEL_ID=                  # support inbox forum
# DISCORD_COMMUNITY_HELP_CHANNEL_ID=   # public help forum the assistant answers in
# DISCORD_HANDOFF_MENTION=             # <@&ROLE_ID>, @here, or empty

# --- Storage --- Defaults to ./data/wicket.db locally. The Docker image uses /data/wicket.db,
# so on Railway mount a volume at /data.
# DATABASE_PATH=./data/wicket.db

# --- Team dashboard at /admin --- Discord sign-in for everyone with the Team role.
# In the bot's Discord application: OAuth2 > Client ID and Client Secret, and add the redirect
# https://YOUR-SERVER/admin/auth/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# PUBLIC_URL=https://wicket.example.com
# TEAM_DISCORD_IDS=          # extra Discord user ids allowed in, comma separated
# TEAM_DEV_LOGIN=true        # local development only: one-click sign-in, no Discord

# Email (Resend): unread team replies are emailed to the user.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Escape Director <support@escapedirector.com>   # a domain verified in Resend
# EMAIL_REPLY_DOMAIN=reply.escapedirector.com                # receiving domain in Resend; replies come back
# RESEND_WEBHOOK_SECRET=whsec_...                            # the webhook pointing at /email/inbound

# Tickets: tag the bot in Discord ("@Wicket file this as a bug") to file it in Linear.
# Personal API key from Linear > Settings > Security & access. Only the Team role can use it.
# LINEAR_API_KEY=
# LINEAR_TEAM_KEY=ED
# LINEAR_SOURCE_LABEL=Source: Discord   # added to each ticket when the label exists
